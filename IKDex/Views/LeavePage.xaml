<UserControl x:Class="IKDex.Views.LeavePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
    <Grid Margin="38,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="İzin Yönetimi" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/><TextBlock x:Name="SummaryText" Margin="0,6,0,0" Foreground="#778195" FontSize="13"/></StackPanel><Button Content="+  Yeni izin talebi" Style="{StaticResource PrimaryButton}" Width="165" HorizontalAlignment="Right" Click="NewRequest_Click"/></Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,18"><TextBlock Text="Durum:" VerticalAlignment="Center" Foreground="#596273" Margin="0,0,10,0"/><ComboBox x:Name="StatusFilter" Width="150" Height="38" SelectionChanged="StatusFilter_SelectionChanged"><ComboBoxItem Content="Tümü" IsSelected="True"/><ComboBoxItem Content="Bekliyor"/><ComboBoxItem Content="Onaylandı"/><ComboBoxItem Content="Reddedildi"/></ComboBox></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource DashboardCard}" Padding="10"><DataGrid x:Name="LeaveGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F4" RowHeight="48" ColumnHeaderHeight="42" SelectionChanged="LeaveGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="PERSONEL" Binding="{Binding EmployeeName}" Width="*"/><DataGridTextColumn Header="İZİN TÜRÜ" Binding="{Binding LeaveType}" Width="120"/><DataGridTextColumn Header="BAŞLANGIÇ" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="95"/><DataGridTextColumn Header="BİTİŞ" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="95"/><DataGridTextColumn Header="GÜN" Binding="{Binding DayCount}" Width="50"/><DataGridTextColumn Header="DURUM" Binding="{Binding Status}" Width="90"/></DataGrid.Columns></DataGrid></Border>
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="22"><StackPanel>
                <TextBlock x:Name="FormTitle" Text="Yeni izin talebi" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <TextBlock Text="Personel *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="EmployeeBox" Height="40" Margin="0,5,0,13" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                <TextBlock Text="İzin türü *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="LeaveTypeBox" Height="40" Margin="0,5,0,13"><ComboBoxItem Content="Yıllık İzin" IsSelected="True"/><ComboBoxItem Content="Mazeret İzni"/><ComboBoxItem Content="Hastalık İzni"/><ComboBoxItem Content="Ücretsiz İzin"/></ComboBox>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Başlangıç *" Style="{StaticResource FormLabel}"/><DatePicker x:Name="StartDatePicker" Height="40" Margin="0,5,0,13" SelectedDateChanged="DateChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Bitiş *" Style="{StaticResource FormLabel}"/><DatePicker x:Name="EndDatePicker" Height="40" Margin="0,5,0,13" SelectedDateChanged="DateChanged"/></StackPanel></Grid>
                <TextBlock x:Name="DayCountText" Text="0 iş günü" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,13"/>
                <TextBlock Text="Açıklama" Style="{StaticResource FormLabel}"/><TextBox x:Name="ReasonBox" Height="70" Margin="0,5,0,13" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="ErrorText" Foreground="#D64550" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                <Button x:Name="SaveButton" Content="Talebi oluştur" Style="{StaticResource PrimaryButton}" Height="44" Click="SaveButton_Click"/>
                <Grid x:Name="ReviewButtons" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Reddet" Height="42" Foreground="#C74752" Background="#FFF3F4" BorderBrush="#F2CDD0" Click="Reject_Click"/><Button Grid.Column="2" Content="Onayla" Height="42" Foreground="White" Background="#35A274" BorderThickness="0" Click="Approve_Click"/></Grid>
            </StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
