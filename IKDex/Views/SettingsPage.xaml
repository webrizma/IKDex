<UserControl x:Class="IKDex.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
 <Grid Margin="38,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Şirket Ayarları" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/><TextBlock Text="Firma bilgilerini, yedekleme ve geri yükleme işlemlerini yönetin." Margin="0,6,0,24" Foreground="#778195"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource DashboardCard}" Padding="25"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Firma bilgileri" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Şirket adı *" Style="{StaticResource FormLabel}"/><TextBox x:Name="CompanyNameBox" Style="{StaticResource CompactInput}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Vergi numarası" Style="{StaticResource FormLabel}"/><TextBox x:Name="TaxNumberBox" Style="{StaticResource CompactInput}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Telefon" Style="{StaticResource FormLabel}"/><TextBox x:Name="PhoneBox" Style="{StaticResource CompactInput}"/></StackPanel></Grid><TextBlock Text="E-posta" Style="{StaticResource FormLabel}"/><TextBox x:Name="EmailBox" Style="{StaticResource CompactInput}"/><TextBlock Text="Adres" Style="{StaticResource FormLabel}"/><TextBox x:Name="AddressBox" Height="70" Margin="0,5,0,13" Padding="10" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="GitHub güncelleme deposu" Style="{StaticResource FormLabel}"/><TextBox x:Name="UpdateRepositoryBox" Style="{StaticResource CompactInput}" ToolTip="https://github.com/kullanici/depo"/><Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><ProgressBar x:Name="UpdateProgress" Height="8" Minimum="0" Maximum="100" VerticalAlignment="Center" Visibility="Collapsed"/><Button Grid.Column="1" Content="Güncelleme ara" Height="36" Margin="10,0,0,0" Click="CheckUpdate_Click"/></Grid><TextBlock x:Name="UpdateStatusText" Foreground="#596273" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/><TextBlock x:Name="SettingsStatusText" Foreground="#25845D" Margin="0,0,0,10" Visibility="Collapsed"/><Button Content="Ayarları kaydet" Style="{StaticResource PrimaryButton}" Height="44" Click="SaveSettings_Click"/></StackPanel></ScrollViewer></Border>
   <StackPanel Grid.Column="2"><Border Style="{StaticResource DashboardCard}" Padding="24" Margin="0,0,0,18"><StackPanel><TextBlock Text="Yedek oluştur" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Veritabanı ve özlük belgelerini tek bir yedek dosyasında saklar." Foreground="#7C8698" TextWrapping="Wrap" LineHeight="20" Margin="0,9,0,16"/><Button Content="Yedekleme dosyası oluştur" Height="44" Background="#24245D" Foreground="White" BorderThickness="0" Click="Backup_Click"/></StackPanel></Border><Border Style="{StaticResource DashboardCard}" Padding="24"><StackPanel><TextBlock Text="Yedekten geri yükle" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Geri yüklemeden önce mevcut verilerin otomatik güvenlik yedeği alınır. İşlemden sonra uygulama kapanır." Foreground="#7C8698" TextWrapping="Wrap" LineHeight="20" Margin="0,9,0,16"/><Button Content="Yedek seç ve geri yükle" Height="44" Foreground="#B4515B" Background="#FFF3F4" BorderBrush="#F0CDD1" Click="Restore_Click"/><TextBlock x:Name="BackupStatusText" Foreground="#25845D" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/></StackPanel></Border></StackPanel>
  </Grid>
 </Grid>
</UserControl>
