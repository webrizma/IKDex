<UserControl x:Class="IKDex.Views.DocumentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
 <Grid Margin="38,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Özlük Belgeleri" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/><TextBlock x:Name="SummaryText" Margin="0,6,0,0" Foreground="#778195"/></StackPanel><Button Content="+  Belge yükle" Style="{StaticResource PrimaryButton}" Width="140" HorizontalAlignment="Right" Click="New_Click"/></Grid>
  <Grid Grid.Row="1" Margin="0,24,0,18"><StackPanel Orientation="Horizontal"><TextBlock Text="Personel:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="EmployeeFilter" Width="220" Height="38" DisplayMemberPath="FullName" SelectedValuePath="Id" SelectionChanged="FilterChanged"/><CheckBox x:Name="ArchivedCheck" Content="Arşivlenenleri göster" Margin="24,0,0,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/></StackPanel></Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource DashboardCard}" Padding="10"><DataGrid x:Name="DocumentsGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="48" SelectionChanged="DocumentsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="PERSONEL" Binding="{Binding EmployeeName}" Width="*"/><DataGridTextColumn Header="BELGE" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="KATEGORİ" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="BOYUT" Binding="{Binding FileSizeText}" Width="75"/><DataGridTextColumn Header="GEÇERLİLİK" Binding="{Binding ExpiryText}" Width="90"/></DataGrid.Columns></DataGrid></Border>
   <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="22"><StackPanel><TextBlock Text="Belge bilgileri" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Personel *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="EmployeeBox" Height="40" Margin="0,5,0,13" DisplayMemberPath="FullName" SelectedValuePath="Id"/><TextBlock Text="Kategori *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="CategoryBox" Height="40" Margin="0,5,0,13"><ComboBoxItem Content="Kimlik"/><ComboBoxItem Content="Sözleşme"/><ComboBoxItem Content="Diploma"/><ComboBoxItem Content="Sertifika"/><ComboBoxItem Content="Sağlık"/><ComboBoxItem Content="Diğer"/></ComboBox><TextBlock Text="Belge adı *" Style="{StaticResource FormLabel}"/><TextBox x:Name="DisplayNameBox" Style="{StaticResource CompactInput}"/><TextBlock Text="Son geçerlilik tarihi" Style="{StaticResource FormLabel}"/><DatePicker x:Name="ExpiryDatePicker" Height="40" Margin="0,5,0,13"/><TextBlock Text="Dosya *" Style="{StaticResource FormLabel}"/><Grid Margin="0,5,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBox x:Name="FilePathBox" Height="40" IsReadOnly="True" VerticalContentAlignment="Center" Padding="9"/><Button Grid.Column="1" Content="Seç" Margin="8,0,0,0" Click="ChooseFile_Click"/></Grid><TextBlock Text="PDF, Word, Excel veya görsel. En fazla 25 MB." Foreground="#8B94A5" FontSize="11" Margin="0,-6,0,13"/><TextBlock x:Name="ErrorText" Foreground="#D64550" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/><Button Content="Belgeyi yükle" Style="{StaticResource PrimaryButton}" Height="44" Click="Save_Click"/><Button x:Name="OpenButton" Content="Belgeyi aç" Height="40" Margin="0,9,0,0" Background="#F7F8FB" BorderBrush="#DDE2EA" Visibility="Collapsed" Click="Open_Click"/><Button x:Name="ArchiveButton" Content="Arşivle" Height="40" Margin="0,9,0,0" Background="Transparent" Foreground="#B55A63" BorderBrush="#E9CDD0" Visibility="Collapsed" Click="Archive_Click"/></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
