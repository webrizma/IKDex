<UserControl x:Class="IKDex.Views.EmployeesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6FA">
    <Grid Margin="38,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Personeller" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/>
                <TextBlock x:Name="CountText" Margin="0,6,0,0" Foreground="#778195" FontSize="13"/>
            </StackPanel>
            <Button Content="+  Yeni personel" Style="{StaticResource PrimaryButton}" Width="148" HorizontalAlignment="Right" Click="NewButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" BorderBrush="#E4E8EF" BorderThickness="1" Width="360" HorizontalAlignment="Left">
                <Grid><TextBlock Text="⌕" FontSize="19" Foreground="#8791A3" Margin="14,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Margin="42,0,8,0" Height="44" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Personel ara"/></Grid>
            </Border>
            <CheckBox Grid.Column="1" x:Name="IncludeInactiveCheck" Content="Pasif personelleri göster" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" Foreground="#5F697A"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource DashboardCard}" Padding="10">
                <DataGrid x:Name="EmployeesGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="White"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F4" HeadersVisibility="Column"
                          SelectionMode="Single" SelectionChanged="EmployeesGrid_SelectionChanged" RowHeight="48" ColumnHeaderHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SİCİL NO" Binding="{Binding EmployeeNumber}" Width="90"/>
                        <DataGridTextColumn Header="AD SOYAD" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="DEPARTMAN" Binding="{Binding Department}" Width="125"/>
                        <DataGridTextColumn Header="POZİSYON" Binding="{Binding Position}" Width="140"/>
                        <DataGridTextColumn Header="DURUM" Binding="{Binding StatusText}" Width="72"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="FormTitle" Text="Yeni personel" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <TextBlock Text="Sicil numarası *" Style="{StaticResource FormLabel}"/><TextBox x:Name="NumberBox" Style="{StaticResource CompactInput}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Ad *" Style="{StaticResource FormLabel}"/><TextBox x:Name="FirstNameBox" Style="{StaticResource CompactInput}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Soyad *" Style="{StaticResource FormLabel}"/><TextBox x:Name="LastNameBox" Style="{StaticResource CompactInput}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="E-posta" Style="{StaticResource FormLabel}"/><TextBox x:Name="EmailBox" Style="{StaticResource CompactInput}"/>
                        <TextBlock Text="Telefon" Style="{StaticResource FormLabel}"/><TextBox x:Name="PhoneBox" Style="{StaticResource CompactInput}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Departman *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="DepartmentBox" Height="40" Margin="0,5,0,13" DisplayMemberPath="Name" SelectedValuePath="Name" SelectionChanged="DepartmentBox_SelectionChanged"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Pozisyon *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="PositionBox" Height="40" Margin="0,5,0,13" DisplayMemberPath="Name" SelectedValuePath="Name"/></StackPanel>
                        </Grid>
                        <TextBlock Text="İşe başlangıç tarihi *" Style="{StaticResource FormLabel}"/><DatePicker x:Name="StartDatePicker" Height="40" Margin="0,5,0,13"/>
                        <TextBlock x:Name="ErrorText" Foreground="#D64550" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                        <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Height="44" Click="SaveButton_Click"/>
                        <Button x:Name="StatusButton" Content="Personeli pasife al" Height="40" Margin="0,9,0,0" Background="Transparent" BorderBrush="#DDE2EA" Cursor="Hand" Visibility="Collapsed" Click="StatusButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
