<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>IKDex.Program</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\ikdex-app.ico</ApplicationIcon>
    <AssemblyName>IKDex</AssemblyName>
    <Product>IKDex İnsan Kaynakları Yönetimi</Product>
    <Version>0.1.0</Version>
    <Authors>IKDex</Authors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\ikdex-app.png" />
    <Content Include="update.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="2.1.11" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
