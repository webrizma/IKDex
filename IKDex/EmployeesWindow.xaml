<Window x:Class="IKDex.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IKDex | Personeller" Height="720" Width="1180" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Personeller" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="CountText" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <Button Content="+ Yeni personel" Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Right" Click="NewButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Width="340" HorizontalAlignment="Left"
                     TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Personel ara"/>
            <CheckBox x:Name="IncludeInactiveCheck" Content="Pasif personelleri göster" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="14" Padding="12">
                <DataGrid x:Name="EmployeesGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single"
                          SelectionChanged="EmployeesGrid_SelectionChanged" RowHeight="46" ColumnHeaderHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sicil no" Binding="{Binding EmployeeNumber}" Width="85"/>
                        <DataGridTextColumn Header="Ad soyad" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Departman" Binding="{Binding Department}" Width="125"/>
                        <DataGridTextColumn Header="Pozisyon" Binding="{Binding Position}" Width="140"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding StatusText}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="FormTitle" Text="Yeni personel" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <TextBlock Text="Sicil numarası *"/><TextBox x:Name="NumberBox" Style="{StaticResource InputBox}" Margin="0,6,0,12"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Ad *"/><TextBox x:Name="FirstNameBox" Style="{StaticResource InputBox}" Margin="0,6,0,12"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Soyad *"/><TextBox x:Name="LastNameBox" Style="{StaticResource InputBox}" Margin="0,6,0,12"/></StackPanel>
                        </Grid>
                        <TextBlock Text="E-posta"/><TextBox x:Name="EmailBox" Style="{StaticResource InputBox}" Margin="0,6,0,12"/>
                        <TextBlock Text="Telefon"/><TextBox x:Name="PhoneBox" Style="{StaticResource InputBox}" Margin="0,6,0,12"/>
                        <TextBlock Text="Departman *"/><TextBox x:Name="DepartmentBox" Style="{StaticResource InputBox}" Margin="0,6,0,12"/>
                        <TextBlock Text="Pozisyon *"/><TextBox x:Name="PositionBox" Style="{StaticResource InputBox}" Margin="0,6,0,12"/>
                        <TextBlock Text="İşe başlangıç tarihi *"/><DatePicker x:Name="StartDatePicker" Height="42" Margin="0,6,0,12" SelectedDate="{x:Static sys:DateTime.Today}" xmlns:sys="clr-namespace:System;assembly=System.Runtime"/>
                        <TextBlock x:Name="ErrorText" Foreground="#D64550" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                        <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
                        <Button x:Name="StatusButton" Content="Personeli pasife al" Height="42" Margin="0,10,0,0"
                                Background="Transparent" BorderBrush="#DDE2EA" Cursor="Hand" Visibility="Collapsed" Click="StatusButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
