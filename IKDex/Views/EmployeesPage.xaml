<UserControl x:Class="IKDex.Views.EmployeesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
    <Grid Margin="38,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Personeller" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/><TextBlock x:Name="CountText" Margin="0,6,0,0" Foreground="#778195" FontSize="13"/></StackPanel>
            <Button Content="＋  Yeni personel" Style="{StaticResource PrimaryButton}" Width="148" HorizontalAlignment="Right" Click="NewButton_Click"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" BorderBrush="#E4E8EF" BorderThickness="1" Width="360" HorizontalAlignment="Left"><Grid><TextBlock Text="⌕" FontSize="19" Foreground="#8791A3" Margin="14,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Margin="42,0,8,0" Height="44" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Personel ara"/></Grid></Border>
            <CheckBox Grid.Column="1" x:Name="IncludeInactiveCheck" Content="Pasif personelleri göster" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" Foreground="#5F697A"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource DashboardCard}" Padding="0" ClipToBounds="True">
                <DataGrid x:Name="EmployeesGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F5" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="EmployeesGrid_SelectionChanged" RowHeight="72" ColumnHeaderHeight="52" RowHeaderWidth="0" CanUserResizeRows="False" CanUserAddRows="False" CanUserReorderColumns="False" FontSize="13">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8F9FC"/><Setter Property="Foreground" Value="#7A8496"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,0"/><Setter Property="BorderBrush" Value="#E8EBF1"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
                        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
                        <Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#253044"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F7F7FE"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EFEEFF"/><Setter Property="Foreground" Value="#27245F"/></Trigger></Style.Triggers></Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PERSONEL" Width="2.1*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="10" Background="#E9E8FF" VerticalAlignment="Center"><TextBlock Text="{Binding Initials}" Foreground="#5753C9" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13" Foreground="#20293A"/><TextBlock Text="{Binding Email}" Margin="0,4,0,0" FontSize="11" Foreground="#8992A3" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="SİCİL NO" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EmployeeNumber}" FontWeight="SemiBold" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="DEPARTMAN" Width="1.15*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#F4F5F8" CornerRadius="7" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Department}" FontSize="11" Foreground="#566174"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="POZİSYON" Width="1.15*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Position}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="DURUM" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="StatusBadge" Background="#E9F8F0" CornerRadius="10" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#28A96B" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#21875A"/></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsActive}" Value="False"><Setter TargetName="StatusBadge" Property="Background" Value="#F3F4F6"/><Setter TargetName="StatusDot" Property="Fill" Value="#98A0AE"/><Setter TargetName="StatusLabel" Property="Foreground" Value="#687284"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock x:Name="FormTitle" Text="Yeni personel" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <TextBlock Text="Sicil numarası *" Style="{StaticResource FormLabel}"/><TextBox x:Name="NumberBox" Style="{StaticResource CompactInput}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ad *" Style="{StaticResource FormLabel}"/><TextBox x:Name="FirstNameBox" Style="{StaticResource CompactInput}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Soyad *" Style="{StaticResource FormLabel}"/><TextBox x:Name="LastNameBox" Style="{StaticResource CompactInput}"/></StackPanel></Grid>
                <TextBlock Text="E-posta" Style="{StaticResource FormLabel}"/><TextBox x:Name="EmailBox" Style="{StaticResource CompactInput}"/>
                <TextBlock Text="Telefon" Style="{StaticResource FormLabel}"/><TextBox x:Name="PhoneBox" Style="{StaticResource CompactInput}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Departman *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="DepartmentBox" Height="40" Margin="0,5,0,13" DisplayMemberPath="Name" SelectedValuePath="Name" SelectionChanged="DepartmentBox_SelectionChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Pozisyon *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="PositionBox" Height="40" Margin="0,5,0,13" DisplayMemberPath="Name" SelectedValuePath="Name"/></StackPanel></Grid>
                <TextBlock Text="İşe başlangıç tarihi *" Style="{StaticResource FormLabel}"/><DatePicker x:Name="StartDatePicker" Height="40" Margin="0,5,0,13"/>
                <TextBlock x:Name="ErrorText" Foreground="#D64550" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                <Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Height="44" Click="SaveButton_Click"/><Button x:Name="StatusButton" Content="Personeli pasife al" Height="40" Margin="0,9,0,0" Background="Transparent" BorderBrush="#DDE2EA" Cursor="Hand" Visibility="Collapsed" Click="StatusButton_Click"/>
            </StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
