<UserControl x:Class="IKDex.Views.OrganizationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
    <Grid Margin="38,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Departmanlar ve Pozisyonlar" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/><TextBlock Text="Organizasyon yapısını ve görev tanımlarını yönetin." Margin="0,6,0,24" Foreground="#778195" FontSize="13"/></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource DashboardCard}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="Departmanlar" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="ShowInactiveDepartments" Content="Pasifleri göster" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/></Grid>
                <DataGrid Grid.Row="1" x:Name="DepartmentsGrid" Margin="0,18" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" SelectionChanged="DepartmentsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="DEPARTMAN" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="DURUM" Binding="{Binding StatusText}" Width="75"/></DataGrid.Columns></DataGrid>
                <StackPanel Grid.Row="2"><TextBlock Text="Departman adı" Style="{StaticResource FormLabel}"/><TextBox x:Name="DepartmentNameBox" Style="{StaticResource CompactInput}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Yeni" Height="42" Background="#F7F8FB" BorderBrush="#E2E6ED" Click="NewDepartment_Click"/><Button Grid.Column="2" Content="Kaydet" Style="{StaticResource PrimaryButton}" Height="42" Click="SaveDepartment_Click"/></Grid><Button x:Name="DepartmentStatusButton" Content="Pasife al" Margin="0,9,0,0" Height="38" Background="Transparent" BorderBrush="#DDE2EA" Visibility="Collapsed" Click="DepartmentStatus_Click"/></StackPanel>
            </Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="Pozisyonlar" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="ShowInactivePositions" Content="Pasifleri göster" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/></Grid>
                <DataGrid Grid.Row="1" x:Name="PositionsGrid" Margin="0,18" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" SelectionChanged="PositionsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="POZİSYON" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="DEPARTMAN" Binding="{Binding DepartmentName}" Width="140"/><DataGridTextColumn Header="DURUM" Binding="{Binding StatusText}" Width="70"/></DataGrid.Columns></DataGrid>
                <StackPanel Grid.Row="2"><TextBlock Text="Bağlı departman" Style="{StaticResource FormLabel}"/><ComboBox x:Name="PositionDepartmentBox" Height="40" Margin="0,5,0,13" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="Pozisyon adı" Style="{StaticResource FormLabel}"/><TextBox x:Name="PositionNameBox" Style="{StaticResource CompactInput}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Yeni" Height="42" Background="#F7F8FB" BorderBrush="#E2E6ED" Click="NewPosition_Click"/><Button Grid.Column="2" Content="Kaydet" Style="{StaticResource PrimaryButton}" Height="42" Click="SavePosition_Click"/></Grid><Button x:Name="PositionStatusButton" Content="Pasife al" Margin="0,9,0,0" Height="38" Background="Transparent" BorderBrush="#DDE2EA" Visibility="Collapsed" Click="PositionStatus_Click"/><TextBlock x:Name="OrganizationErrorText" Foreground="#D64550" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/></StackPanel>
            </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
