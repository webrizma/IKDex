<UserControl x:Class="IKDex.Views.AttendancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
 <Grid Margin="38,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Puantaj" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/><TextBlock x:Name="SummaryText" Margin="0,6,0,0" Foreground="#778195"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="NowInButton" Content="Şimdi giriş yap" Height="44" Padding="18,0" Margin="0,0,10,0" Background="#EAF8F2" Foreground="#25845D" BorderBrush="#C6EBDD" Click="NowIn_Click"/><Button x:Name="NowOutButton" Content="Şimdi çıkış yap" Height="44" Padding="18,0" Background="#FFF4E8" Foreground="#B66A20" BorderBrush="#F2D8B9" Click="NowOut_Click"/></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="0,24,0,18"><StackPanel Orientation="Horizontal"><TextBlock Text="Ay:" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="MonthPicker" Width="145" Height="38" SelectedDateChanged="FilterChanged"/><TextBlock Text="Personel:" VerticalAlignment="Center" Margin="18,0,8,0"/><ComboBox x:Name="EmployeeFilter" Width="210" Height="38" DisplayMemberPath="FullName" SelectedValuePath="Id" SelectionChanged="FilterChanged"/></StackPanel></Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource DashboardCard}" Padding="10"><DataGrid x:Name="AttendanceGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="48" SelectionChanged="AttendanceGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="TARİH" Binding="{Binding WorkDate,StringFormat=dd.MM.yyyy}" Width="95"/><DataGridTextColumn Header="PERSONEL" Binding="{Binding EmployeeName}" Width="*"/><DataGridTextColumn Header="GİRİŞ" Binding="{Binding CheckInText}" Width="75"/><DataGridTextColumn Header="ÇIKIŞ" Binding="{Binding CheckOutText}" Width="75"/><DataGridTextColumn Header="ÇALIŞMA" Binding="{Binding WorkedText}" Width="80"/><DataGridTextColumn Header="NOT" Binding="{Binding Note}" Width="130"/></DataGrid.Columns></DataGrid></Border>
   <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="22"><StackPanel><TextBlock Text="Puantaj kaydı" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Personel *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="EmployeeBox" Height="40" Margin="0,5,0,13" DisplayMemberPath="FullName" SelectedValuePath="Id"/><TextBlock Text="Tarih *" Style="{StaticResource FormLabel}"/><DatePicker x:Name="WorkDatePicker" Height="40" Margin="0,5,0,13"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Giriş (08:30)" Style="{StaticResource FormLabel}"/><TextBox x:Name="CheckInBox" Style="{StaticResource CompactInput}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Çıkış (17:30)" Style="{StaticResource FormLabel}"/><TextBox x:Name="CheckOutBox" Style="{StaticResource CompactInput}"/></StackPanel></Grid><TextBlock Text="Not" Style="{StaticResource FormLabel}"/><TextBox x:Name="NoteBox" Height="65" Margin="0,5,0,13" Padding="10" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock x:Name="ErrorText" Foreground="#D64550" Margin="0,0,0,10" Visibility="Collapsed" TextWrapping="Wrap"/><Button x:Name="SaveButton" Content="Kaydet" Style="{StaticResource PrimaryButton}" Height="44" Click="Save_Click"/></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
