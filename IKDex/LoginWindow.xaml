<Window x:Class="IKDex.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IKDex | Giriş" Height="680" Width="1080"
        MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Icon="Assets/ikdex-app.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#24245D" Margin="22" CornerRadius="24">
            <Grid Margin="52">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" Background="#7777F2" CornerRadius="11">
                        <TextBlock Text="İK" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="IKDex" Foreground="White" FontWeight="Bold" FontSize="22"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Border Background="#343478" CornerRadius="18" Padding="18" HorizontalAlignment="Left" Margin="0,0,0,30">
                        <TextBlock Text="✦  İnsan kaynakları, tek bir yerde" Foreground="#DADAFF" FontSize="13" />
                    </Border>
                    <TextBlock Text="Ekibinizi daha iyi\ntanıyın ve yönetin." Foreground="White"
                               FontSize="38" FontWeight="SemiBold" LineHeight="49" />
                    <TextBlock Text="Personel, izin ve şirket süreçlerinizi sade bir deneyimle yönetin."
                               Foreground="#C5C6DE" FontSize="15" TextWrapping="Wrap" LineHeight="24"
                               Width="390" HorizontalAlignment="Left" Margin="0,22,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Güvenli • Hızlı • Kullanımı kolay" Foreground="#9D9EC2" FontSize="12" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="72,50">
            <StackPanel VerticalAlignment="Center" MaxWidth="390">
                <TextBlock Text="Tekrar hoş geldiniz" Foreground="{StaticResource TextBrush}"
                           FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Devam etmek için hesabınıza giriş yapın." Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14" Margin="0,9,0,34" />

                <TextBlock Text="Kullanıcı adı" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="UserNameBox" Style="{StaticResource InputBox}" Text="admin"
                         AutomationProperties.Name="Kullanıcı adı" />

                <TextBlock Text="Şifre" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,22,0,8" />
                <PasswordBox x:Name="PasswordBox" Height="46" Padding="14,0" FontSize="14"
                             VerticalContentAlignment="Center" BorderBrush="#DDE2EA" Background="#FAFBFC"
                             Password="1234" AutomationProperties.Name="Şifre" KeyDown="PasswordBox_KeyDown" />

                <Grid Margin="0,14,0,20">
                    <CheckBox Content="Beni hatırla" Foreground="{StaticResource MutedTextBrush}" IsChecked="True" />
                    <TextBlock Text="Şifremi unuttum" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" />
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="#D64550" FontSize="13" Margin="0,0,0,10"
                           Visibility="Collapsed" TextWrapping="Wrap" />
                <Button x:Name="LoginButton" Content="Giriş yap" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click" />

                <Border Background="#EEF0FF" CornerRadius="10" Padding="14" Margin="0,24,0,0">
                    <TextBlock Foreground="#55568A" FontSize="12" TextWrapping="Wrap">
                        <Run Text="Demo hesabı: " FontWeight="SemiBold"/><Run Text="admin"/><Run Text="  •  Şifre: "/><Run Text="1234"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
