<UserControl x:Class="IKDex.Views.ReportsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
 <Grid Margin="38,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Raporlar" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/><TextBlock Text="İK verilerini Excel veya PDF biçiminde dışa aktarın." Margin="0,6,0,24" Foreground="#778195"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource DashboardCard}" Padding="26"><StackPanel><TextBlock Text="Rapor oluştur" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,22"/><TextBlock Text="Rapor türü" Style="{StaticResource FormLabel}"/><ComboBox x:Name="ReportTypeBox" Height="44" Margin="0,6,0,18" SelectionChanged="ReportTypeChanged"><ComboBoxItem Content="Personel Listesi" IsSelected="True"/><ComboBoxItem Content="İzin Raporu"/><ComboBoxItem Content="Puantaj Raporu"/></ComboBox><TextBlock Text="Rapor dönemi" Style="{StaticResource FormLabel}"/><DatePicker x:Name="MonthPicker" Height="44" Margin="0,6,0,18"/><Border Background="#F7F8FB" CornerRadius="10" Padding="16" Margin="0,2,0,20"><StackPanel><TextBlock Text="Rapor içeriği" FontWeight="SemiBold" Foreground="#414A5A"/><TextBlock x:Name="DescriptionText" Text="Aktif ve pasif tüm personelin güncel bilgileri." TextWrapping="Wrap" Foreground="#7C8698" FontSize="12" Margin="0,7,0,0"/></StackPanel></Border><TextBlock x:Name="StatusText" Foreground="#25845D" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Excel'e aktar" Style="{StaticResource PrimaryButton}" Height="46" Click="Excel_Click"/><Button Grid.Column="2" Content="PDF'e aktar" Height="46" Background="#24245D" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Pdf_Click"/></Grid></StackPanel></Border>
   <StackPanel Grid.Column="2"><Border Style="{StaticResource DashboardCard}" Padding="24" Margin="0,0,0,18"><StackPanel><TextBlock Text="Excel raporu" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Filtrelenebilir başlıklar, ayarlanmış sütun genişlikleri ve sabitlenmiş başlık satırıyla .xlsx dosyası oluşturur." TextWrapping="Wrap" Foreground="#7C8698" FontSize="12" LineHeight="20" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource DashboardCard}" Padding="24"><StackPanel><TextBlock Text="PDF raporu" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Yazdırmaya uygun yatay sayfa düzeninde, sayfalara otomatik bölünen kurumsal rapor oluşturur." TextWrapping="Wrap" Foreground="#7C8698" FontSize="12" LineHeight="20" Margin="0,10,0,0"/></StackPanel></Border></StackPanel>
  </Grid>
 </Grid>
</UserControl>
