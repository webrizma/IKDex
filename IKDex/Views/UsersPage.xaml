<UserControl x:Class="IKDex.Views.UsersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
 <Grid Margin="38,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Kullanıcılar ve Yetkiler" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/><TextBlock Text="Uygulama hesaplarını ve erişim seviyelerini yönetin." Margin="0,6,0,24" Foreground="#778195"/></StackPanel><Button Content="+  Yeni kullanıcı" Style="{StaticResource PrimaryButton}" Width="150" HorizontalAlignment="Right" Click="New_Click"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource DashboardCard}" Padding="10"><DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="48" SelectionChanged="UsersGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="KULLANICI" Binding="{Binding UserName}" Width="120"/><DataGridTextColumn Header="AD SOYAD" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="ROL" Binding="{Binding Role}" Width="120"/><DataGridTextColumn Header="PERSONEL" Binding="{Binding EmployeeName}" Width="130"/><DataGridTextColumn Header="DURUM" Binding="{Binding StatusText}" Width="70"/></DataGrid.Columns></DataGrid></Border>
   <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="22"><StackPanel><TextBlock x:Name="FormTitle" Text="Yeni kullanıcı" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Kullanıcı adı *" Style="{StaticResource FormLabel}"/><TextBox x:Name="UserNameBox" Style="{StaticResource CompactInput}"/><TextBlock Text="Ad soyad *" Style="{StaticResource FormLabel}"/><TextBox x:Name="FullNameBox" Style="{StaticResource CompactInput}"/><TextBlock Text="Rol *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="RoleBox" Height="40" Margin="0,5,0,13"><ComboBoxItem Content="İK Yöneticisi"/><ComboBoxItem Content="İK Uzmanı"/><ComboBoxItem Content="Çalışan"/></ComboBox><TextBlock Text="Bağlı personel" Style="{StaticResource FormLabel}"/><ComboBox x:Name="EmployeeBox" Height="40" Margin="0,5,0,13" DisplayMemberPath="FullName" SelectedValuePath="Id"/><TextBlock Text="Yeni parola" Style="{StaticResource FormLabel}"/><PasswordBox x:Name="PasswordBox" Height="40" Margin="0,5,0,13" Padding="10"/><TextBlock Text="Yeni hesaplarda en az 6 karakter zorunludur." Foreground="#8B94A5" FontSize="11" Margin="0,-7,0,13"/><TextBlock x:Name="ErrorText" Foreground="#D64550" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/><Button Content="Kaydet" Style="{StaticResource PrimaryButton}" Height="44" Click="Save_Click"/><Button x:Name="StatusButton" Content="Hesabı pasife al" Height="40" Margin="0,9,0,0" Background="Transparent" BorderBrush="#DDE2EA" Visibility="Collapsed" Click="Status_Click"/></StackPanel></Border>
  </Grid>
 </Grid>
</UserControl>
