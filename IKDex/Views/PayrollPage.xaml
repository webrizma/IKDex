<UserControl x:Class="IKDex.Views.PayrollPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA">
 <Grid Margin="38,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Bordro Yönetimi" FontSize="28" FontWeight="SemiBold" Foreground="#19202D"/><TextBlock x:Name="SummaryText" Margin="0,6,0,0" Foreground="#778195"/></StackPanel><Button Content="+  Yeni bordro" Style="{StaticResource PrimaryButton}" Width="140" HorizontalAlignment="Right" Click="New_Click"/></Grid>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,18"><TextBlock Text="Dönem:" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="PeriodPicker" Width="150" Height="38" SelectedDateChanged="PeriodChanged"/></StackPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource DashboardCard}" Padding="10"><DataGrid x:Name="PayrollGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="48" SelectionChanged="PayrollGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="PERSONEL" Binding="{Binding EmployeeName}" Width="*"/><DataGridTextColumn Header="BRÜT KAZANÇ" Binding="{Binding TotalEarnings,StringFormat={}{0:N2} ₺}" Width="115"/><DataGridTextColumn Header="KESİNTİ" Binding="{Binding TotalDeductions,StringFormat={}{0:N2} ₺}" Width="105"/><DataGridTextColumn Header="NET ÜCRET" Binding="{Binding NetSalary,StringFormat={}{0:N2} ₺}" Width="115"/><DataGridTextColumn Header="DURUM" Binding="{Binding Status}" Width="85"/></DataGrid.Columns></DataGrid></Border>
   <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="FormTitle" Text="Yeni bordro" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Personel *" Style="{StaticResource FormLabel}"/><ComboBox x:Name="EmployeeBox" Height="38" Margin="0,5,0,12" DisplayMemberPath="FullName" SelectedValuePath="Id"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Brüt ücret *" Style="{StaticResource FormLabel}"/><TextBox x:Name="GrossBox" Style="{StaticResource CompactInput}" TextChanged="AmountChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Prim / ikramiye" Style="{StaticResource FormLabel}"/><TextBox x:Name="BonusBox" Style="{StaticResource CompactInput}" TextChanged="AmountChanged"/></StackPanel></Grid><TextBlock Text="Fazla mesai ücreti" Style="{StaticResource FormLabel}"/><TextBox x:Name="OvertimeBox" Style="{StaticResource CompactInput}" TextChanged="AmountChanged"/>
    <TextBlock Text="Kesintiler" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SGK çalışan payı" Style="{StaticResource FormLabel}"/><TextBox x:Name="SocialBox" Style="{StaticResource CompactInput}" TextChanged="AmountChanged"/><TextBlock Text="Gelir vergisi" Style="{StaticResource FormLabel}"/><TextBox x:Name="IncomeTaxBox" Style="{StaticResource CompactInput}" TextChanged="AmountChanged"/><TextBlock Text="Diğer kesintiler" Style="{StaticResource FormLabel}"/><TextBox x:Name="OtherBox" Style="{StaticResource CompactInput}" TextChanged="AmountChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="İşsizlik çalışan payı" Style="{StaticResource FormLabel}"/><TextBox x:Name="UnemploymentBox" Style="{StaticResource CompactInput}" TextChanged="AmountChanged"/><TextBlock Text="Damga vergisi" Style="{StaticResource FormLabel}"/><TextBox x:Name="StampTaxBox" Style="{StaticResource CompactInput}" TextChanged="AmountChanged"/></StackPanel></Grid>
    <Border Background="#F1F0FF" CornerRadius="10" Padding="14" Margin="0,0,0,13"><Grid><StackPanel><TextBlock Text="Hesaplanan net ücret" Foreground="#69658C" FontSize="11"/><TextBlock x:Name="NetSalaryText" Text="0,00 ₺" Foreground="#302B87" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="Toplam kesinti" Foreground="#69658C" FontSize="11"/><TextBlock x:Name="TotalDeductionText" Text="0,00 ₺" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid></Border><TextBlock Text="Not" Style="{StaticResource FormLabel}"/><TextBox x:Name="NotesBox" Height="55" Margin="0,5,0,12" Padding="9" AcceptsReturn="True"/><TextBlock x:Name="ErrorText" Foreground="#D64550" TextWrapping="Wrap" Margin="0,0,0,9" Visibility="Collapsed"/><Button x:Name="SaveButton" Content="Taslak kaydet" Style="{StaticResource PrimaryButton}" Height="42" Click="Save_Click"/><Grid x:Name="StatusButtons" Visibility="Collapsed" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Onayla" Height="40" Background="#EAF8F2" Foreground="#25845D" BorderBrush="#C6EBDD" Click="Approve_Click"/><Button Grid.Column="2" Content="Ödendi işaretle" Height="40" Background="#24245D" Foreground="White" BorderThickness="0" Click="Paid_Click"/></Grid><TextBlock Text="Kesintiler manuel girilir; bu sürüm resmi mevzuat hesaplama motoru değildir." Foreground="#9A6B35" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
 </Grid>
</UserControl>
