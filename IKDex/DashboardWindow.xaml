<Window x:Class="IKDex.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IKDex | İnsan Kaynakları" Height="760" Width="1240"
        MinHeight="680" MinWidth="1080" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#202052">
            <Grid Margin="22,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,42">
                    <Border Width="38" Height="38" Background="#7777F2" CornerRadius="10">
                        <TextBlock Text="İK" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="IKDex" Foreground="White" FontWeight="Bold" FontSize="21" VerticalAlignment="Center" Margin="11,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Border Background="#393978" CornerRadius="9" Padding="14,12" Margin="0,0,0,8">
                        <TextBlock Text="⌂   Genel Bakış" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <Button Content="♙   Personeller" Foreground="#BDBED6" Background="Transparent" BorderThickness="0"
                            Padding="14,12" HorizontalContentAlignment="Left" Cursor="Hand" Click="EmployeesButton_Click" />
                    <TextBlock Text="▣   İzin Yönetimi" Foreground="#BDBED6" Padding="14,12" />
                    <TextBlock Text="◷   Puantaj" Foreground="#BDBED6" Padding="14,12" />
                    <TextBlock Text="▤   Raporlar" Foreground="#BDBED6" Padding="14,12" />
                    <TextBlock Text="⚙   Ayarlar" Foreground="#BDBED6" Padding="14,12" />
                </StackPanel>

                <Button Grid.Row="2" Content="Oturumu kapat" Foreground="#D7D7E8" Background="Transparent"
                        BorderBrush="#4B4B79" BorderThickness="1" Height="42" Cursor="Hand" Click="LogoutButton_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="Genel Bakış" Foreground="{StaticResource TextBrush}" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock x:Name="WelcomeText" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Border Width="42" Height="42" Background="#E6E7FF" CornerRadius="21">
                            <TextBlock Text="AD" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,2,0,0">
                            <TextBlock x:Name="UserFullNameText" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="UserRoleText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,30,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="20">
                        <StackPanel><TextBlock Text="Aktif personel" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="EmployeeCountText" Text="0" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Personel kayıtları" Foreground="#2E9D72" FontSize="12"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20">
                        <StackPanel><TextBlock Text="Bugün izinli" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="8" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="6 departmandan" Foreground="#D98C32" FontSize="12"/></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="White" CornerRadius="14" Padding="20">
                        <StackPanel><TextBlock Text="Açık pozisyon" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="6" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="14 aktif aday" Foreground="{StaticResource PrimaryBrush}" FontSize="12"/></StackPanel>
                    </Border>
                    <Border Grid.Column="6" Background="White" CornerRadius="14" Padding="20">
                        <StackPanel><TextBlock Text="Bekleyen talepler" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="12" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Onayınızı bekliyor" Foreground="#D64550" FontSize="12"/></StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="14" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Son personel hareketleri" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,18" />
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Ayşe Yılmaz" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Ürün Tasarım" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Grid.Column="2" Text="Yeni başladı" Foreground="#2E9D72"/></Grid>
                            <Separator Background="#EEF0F4"/>
                            <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Mehmet Kaya" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Yazılım" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Grid.Column="2" Text="Terfi etti" Foreground="{StaticResource PrimaryBrush}"/></Grid>
                            <Separator Background="#EEF0F4"/>
                            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Elif Demir" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Pazarlama" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Grid.Column="2" Text="İzinli" Foreground="#D98C32"/></Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Yaklaşan etkinlikler" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                            <Border Background="#F3F3FF" CornerRadius="10" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="16 EYL" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Aylık ekip buluşması" Margin="0,5,0,0" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Background="#FFF7EB" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="20 EYL" Foreground="#C87922" FontSize="11" FontWeight="Bold"/><TextBlock Text="Performans görüşmeleri" Margin="0,5,0,0" FontWeight="SemiBold"/></StackPanel></Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
